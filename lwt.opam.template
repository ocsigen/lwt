build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "exec"
    "-p"
    name
    "src/unix/config/discover.exe"
    "--"
    "--save"
    "--use-libev" "%{conf-libev:installed}%"
  ]
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent:[ "(latest)" ]
pin-depends: [
  [ "ppx_devtools-optcomp.dev"
    "git+https://github.com/ocsigen/ppx_devtools.git#96f0fe04f99f01cca3419851a42b79eec5094314" ]
]
