(test
 (name main)
 (package lwt)
 (modules
  (:standard
   \
   test_protected_cancel
   test_lwt_dls
   test_storage_domains
   test_lwt_dls_domains
   test_sched_domains
   test_ownership
   test_ownership_modules))
 (libraries lwttester))

; Standalone tests:
; - test_protected_cancel: p resolving after Lwt.protected p has been canceled.
;   This used to crash, so it is not part of the main suite.
; - test_lwt_dls: the per-domain slot, single-domain half.

(tests
 (names test_protected_cancel test_lwt_dls)
 (package lwt)
 (modules test_protected_cancel test_lwt_dls)
 (libraries lwt))

; Tests that need a second domain, hence OCaml 5:
; - test_storage_domains: the Lwt.key storage.
; - test_lwt_dls_domains: the per-domain slot, two-domain half.
; - test_sched_domains: the core scheduler is per domain.
; - test_ownership: the always-on ownership check, and what it must not reject.
; - test_ownership_modules: the ownership check of mutexes, condition
;   variables, mvars, pools, streams and switches.

(tests
 (names
  test_storage_domains
  test_lwt_dls_domains
  test_sched_domains
  test_ownership
  test_ownership_modules)
 (package lwt)
 (modules
  test_storage_domains
  test_lwt_dls_domains
  test_sched_domains
  test_ownership
  test_ownership_modules)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt))
