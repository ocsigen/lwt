; A GC finalizer that creates a notification while the table of notifiers is
; being updated.

(test
 (package lwt)
 (name notification_reentry)
 (libraries lwt lwt.unix threads)
 (modules notification_reentry))

; A notification pending at a fork is dropped in the child, whose own
; notifications still reach its loop. Uses fork, hence not on Windows.

(test
 (name fork_pending_notification)
 (package lwt)
 (modules fork_pending_notification)
 (enabled_if
  (<> %{os_type} "Win32"))
 (libraries lwt.unix))

; A signal arriving while the notification buffer is full is delivered,
; without the handler growing the buffer. Uses SIGUSR1 and Unix.alarm, hence
; not on Windows.

(test
 (name signal_full_buffer)
 (package lwt)
 (modules signal_full_buffer)
 (enabled_if
  (<> %{os_type} "Win32"))
 (libraries lwt.unix))

; Job completions on many worker threads at once while the notification buffer
; is full. Uses a FIFO, hence not on Windows.

(test
 (name notification_growth)
 (package lwt)
 (modules notification_growth)
 (enabled_if
  (<> %{os_type} "Win32"))
 (libraries lwt.unix))

; A notification handler that raises does not lose the rest of its batch.

(test
 (name notification_batch)
 (package lwt)
 (modules notification_batch)
 (libraries lwt.unix))

