; The main domain's exit hooks can still run jobs. The test passes if the
; program exits. Builds everywhere, since it needs no second domain.

(test
 (name domain_exit_main)
 (package lwt)
 (modules domain_exit_main)
 (libraries lwt.unix threads))

; Every loop has its own notification channel, and an id carries the channel it
; belongs to. Needs a second domain, hence OCaml 5.

(test
 (name domain_notifications)
 (package lwt)
 (modules domain_notifications)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix threads))

(executable
 (name dummy)
 (modules dummy)
 (libraries unix))

(test
 (name main)
 (package lwt)
 (libraries lwttester tester)
 (modules main)
 (deps bytes_io_data %{exe:dummy.exe}))

