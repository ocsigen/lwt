; Each domain flushes its own output channels. Needs a second domain, hence
; OCaml 5.

(test
 (name domain_channels)
 (package lwt)
 (modules domain_channels)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; Jobs work on every domain. Signals and child waiting belong to the domain
; that initialized Lwt_unix. Needs a second domain, hence OCaml 5, and
; Unix.fork and SIGUSR1, hence not Windows.

(test
 (name domain_unix_policy)
 (package lwt)
 (modules domain_unix_policy)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (enabled_if
  (<> %{os_type} "Win32"))
 (libraries lwt.unix))

