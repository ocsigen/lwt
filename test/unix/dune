; Loop creation when descriptors are exhausted: must fail with EMFILE and
; leave the channel table usable. The test lowers its own limit by re-running
; itself under a shell, hence not on Windows. Needs a second domain, hence
; OCaml 5.

(test
 (name domain_emfile)
 (package lwt)
 (modules domain_emfile)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (enabled_if
  (<> %{os_type} "Win32"))
 (libraries lwt.unix))

