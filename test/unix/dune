; The SIGCHLD handler installed, and temporary names drawn, from several
; domains at once. OCaml 5 only.

(test
 (package lwt)
 (name domain_shared_lazies)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt lwt.unix)
 (modules domain_shared_lazies))

; Exit hooks run on the domain that registered them. Needs a second domain,
; hence OCaml 5.

(test
 (name domain_exit_hooks)
 (package lwt)
 (modules domain_exit_hooks)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))
