(library
 (public_name lwt)
 (synopsis "Monadic promises and concurrent I/O")
 (wrapped false)
 (preprocess
  (per_module
   ((pps ppx_devtools-optcomp)
    lwt_key_storage)))
 (private_modules lwt_key_storage)
 (libraries
  (select
   lwt_rte.ml
   from
   (lwt_runtime_events -> lwt_rte.with.ml)
   (-> lwt_rte.without.ml))))

(documentation
 (package lwt))
